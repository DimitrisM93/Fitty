# Google OAuth 2.0 Client ID
# Get yours at: https://console.cloud.google.com/apis/credentials
# Create a "Web application" OAuth client and add your domain to authorized origins
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Backend Environment Variables
# The below variables should be configured in your Vercel deployment settings or a local .env file.

# Gemini API Key (Required for photo meal analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for fast text-based meal analysis)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database URL (e.g., from Neon, Supabase, or your own hosting)
DATABASE_URL=your_postgres_database_url_here

# App Authentication PIN (The passcode used to log into the app)
APP_PIN=1234

# Optional: Secret used for signing JWT tokens (if omitted, falls back to APP_PIN)
JWT_SECRET=your_random_jwt_secret_here
